# Run as root in a XeeonOS virtual machine with the extension on
# (tools/boot-check.sh). No NVIDIA card there: the driver is in place for
# the running kernel, and Nouveau would not load.
module=$(modinfo -n nvidia)
resolved=$(readlink -e "$module")
modules=$(readlink -e "/usr/lib/modules/$(uname -r)")
echo "nvidia: $module ($(modinfo -F version nvidia))"
case $resolved in "$modules"/*) ;; *) exit 1 ;; esac
modinfo -n nvidia_drm
modprobe -c | grep -qx 'blacklist nouveau'
echo "nouveau: blacklisted"
nvidia-smi --version | head -n1 || true
test -f /usr/share/vulkan/icd.d/nvidia_icd.json
systemctl is-enabled xeeonos-nvidia-switch.service
